    function int sin(int angle) {
        var int quadrant;
        var int value;

        // Evita angulos maiores que 360
        let angle = Math.mod(angle, 360);

        if (angle < 90) {
            return sinTable[angle];
        }
        if (angle < 180) {
            return sinTable[180 - angle];
        }
        if (angle < 270) {
            return -sinTable[angle - 180];
        }
        return -sinTable[360 - angle];
    }

    function int cos(int angle) {
        return Math.sin(angle + 90);
    }

    function int mod(int x, int y) {
        // x - ((x/y) * y)
        // 
        // 380 - (380/360 * 360) 
        // 380 - (~1 * 360)
        // = 20  
        return x - (Math.divide(x,y) * y);
    }
}