class Player {
    // lembrando que Fixed = Q8.8 (fp)
    field int xFixed;
    field int yFixed;
    field int angle;
    field int velocityFixed;
    field int velRot;
    field Map map;

    constructor Player new(Map nmap) {
        let map = nmap;

        let xFixed = map.getPlayerStartX() * 256; // o mapa tem o spawpoint do player
        let yFixed = map.getPlayerStartY() * 256; // aqui apenas transformamos em Fixed
        
        //
        // ATEÇÃO
        // as seguintes variaveis podem ser modificadas
        // para mudar sua esperiencia em jogo
        let angle = 270; // angulo inicial do player 
        let velocityFixed = 64; // velocidade em Fixed, 64 = 0.25 tiles por loop
        let velRot = 10; // velocidade de rotação, 10 = 10⁰ por loop

        return this;
    }

    // aqui centraliza todos os movimentos possiveis para o player, 
    // dependendo apenas do angulo de direção
    method void move(int directionAngle) {
        var int dxFixed;
        var int dyFixed;
        var int newXFixed;
        var int newYFixed;

        // normaliza o angulo
        let directionAngle = Math.mod(directionAngle, 360);

        // apenas a variação aplicada no eixo x
        // cos(angle) * vel
        // como ambos são em Fixed uso Math.fixed
        let dxFixed = Math.fixedMul(
            Math.cos(directionAngle),
            velocityFixed
        );

        // mesma coisa que o de cima porém
        // sin(angle) * vel
        let dyFixed = Math.fixedMul(
            Math.sin(directionAngle),
            velocityFixed
        );

        let newXFixed = xFixed + dxFixed;
        let newYFixed = yFixed + dyFixed;

        // se a nova posição não é parede
        // efetua o movimento
        if (~map.isWall(newXFixed / 256, yFixed / 256)) {
            let xFixed = newXFixed;
        }
        if (~map.isWall(xFixed / 256, newYFixed / 256)) {
            let yFixed = newYFixed;
        }
        return;
    }

    // Mover para frente 
    method void moveForward() {
        do move(angle);
        return;
    }

    // Mover para trás 
    method void moveBackward() {
        do move(angle + 180);
        return;
    }

    // Mover para esquerda
    method void moveLeft() {
        do move(angle - 90);
        return;
    }

    // Mover para direita
    method void moveRight() {
        do move(angle + 90);
        return;
    }

    // metodo que centraliza a lógica de rotação do angulo do player
    // -1 = Left
    // 1 = Right
    method void rotate(int dir) {
        let angle = angle + (dir * velRot);

        if (angle < 0 | angle > 359) {
            let angle = angle - (dir * 360);
        }

        return;
    }

    method void rotateLeft() {
        do rotate(-1);
        return;
    }

    method void rotateRight() {
        do rotate(1);
        return;
    }

    method int getXFixed() {
        return xFixed;
    }

    method int getYFixed() {
        return yFixed;
    }

    method int getAngle() {
        return angle;
    }
}