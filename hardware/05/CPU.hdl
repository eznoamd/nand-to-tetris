CHIP CPU {

    IN  inM[16],         // valor de entrada M (conteúdo de RAM[A])
        instruction[16], // instrução para execução
        reset;           // sinal para reiniciar (reset==1) ou continuar (reset==0)

    OUT outM[16],        // valor de saída M
        writeM,          // escrever em M?
        addressM[15],    // endereço na memória de dados (de M)
        pc[15];          // endereço da próxima instrução

    PARTS:
    // Análise da instrução
    Not(in=instruction[15], out=aInstruction);
    Not(in=aInstruction, out=cInstruction);
    
    // Lógica do registrador A
    Mux16(a=instruction, b=aluOut, sel=instruction[15], out=aInput);
    Register(in=aInput, load=instruction[15], out=aOut, out[0..14]=addressM);
    
    // Registrador D
    Register(in=aluOut, load=instruction[4] and cInstruction, out=dOut);
    
    // Seleção de entrada da ALU
    Mux16(a=aOut, b=inM, sel=instruction[12], out=aluY);
    
    // ALU
    ALU(x=dOut, y=aluY, zx=instruction[11], nx=instruction[10], zy=instruction[9], ny=instruction[8], f=instruction[7], no=instruction[6], out=aluOut, out=outM, zr=zr, ng=ng);
    
    // Saída writeM
    And(a=instruction[3], b=cInstruction, out=writeM);
    
    // Lógica de jump
    Not(in=zr, out=notZr);
    Not(in=ng, out=notNg);
    
    And(a=notZr, b=notNg, out=positive);
    
    And(a=ng, b=zr, out=zero); // Nunca deve ser 1
    Or(a=ng, b=zr, out=notPositive);
    
    // Condições de jump
    And(a=positive, b=instruction[0], out=jgt);
    And(a=zr, b=instruction[1], out=jeq);
    And(a=ng, b=instruction[2], out=jlt);
    
    Or(a=jgt, b=jeq, out=jge);
    Or(a=jlt, b=jeq, out=jle);
    Or(a=jgt, b=jlt, out=jne);
    
    Or(a=jgt, b=jeq, out=jump1);
    Or(a=jump1, b=jlt, out=jump);
    
    And(a=jump, b=cInstruction, out=loadPc);
    Not(in=loadPc, out=incPc);
    
    // PC
    PC(in=aOut, load=loadPc, inc=incPc, reset=reset, out[0..14]=pc);
}